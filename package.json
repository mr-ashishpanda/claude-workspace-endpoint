{
  "name": "slack-claude-bridge",
  "version": "0.1.0",
  "description": "Local-first bridge between Slack and Claude Code, scoped to per-channel workspaces.",
  "type": "module",
  "license": "MIT",
  "author": "Ashish Panda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-ashishpanda/claude-workspace-endpoint.git"
  },
  "homepage": "https://github.com/mr-ashishpanda/claude-workspace-endpoint#readme",
  "bugs": {
    "url": "https://github.com/mr-ashishpanda/claude-workspace-endpoint/issues"
  },
  "keywords": [
    "slack",
    "claude",
    "claude-code",
    "bot",
    "bridge",
    "socket-mode"
  ],
  "bin": {
    "slack-claude": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs/slack-app-manifest.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "bridge:logs": "tsx src/cli/index.ts logs -f"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "@slack/web-api": "^7.17.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
