# Slack-Claude Bridge — configuration template.
#
# You do NOT need this file for a normal install: run `slack-claude init`, which
# writes a per-user config .env (with 0600 perms) to your OS config dir:
#   Linux:   $XDG_CONFIG_HOME/slack-claude/.env  (default ~/.config/slack-claude/.env)
#   macOS:   ~/Library/Application Support/slack-claude/.env
#   Windows: %APPDATA%\slack-claude\Config\.env
#
# This template is for development from a clone: copy it to a project-local .env
# and the bridge will load it (a project .env takes precedence over the per-user
# one). NEVER commit .env (it is gitignored and edit-blocked by a hook).

# Slack app credentials (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # Socket Mode app-level token
SLACK_SIGNING_SECRET=...

# Local storage for sessions + mappings. Omit to use the per-user data dir:
#   Linux ~/.local/state/slack-claude · macOS ~/Library/Application Support/slack-claude
#   Windows %LOCALAPPDATA%\slack-claude\Data. For dev, pin it to the project:
SLACK_CLAUDE_HOME=.slack-claude

# Path to the Claude Code CLI invoked per workspace (usually just "claude")
CLAUDE_CLI_BIN=claude

# Logging. Omit LOG_FILE to use the per-user log dir (see `slack-claude logs`).
LOG_LEVEL=info                    # debug | info | warn | error
LOG_FILE=logs/bridge.log
# Log rotation: rotate the file once it passes LOG_MAX_SIZE bytes, keeping
# LOG_MAX_FILES archives (bridge.log.1 … .N). Total history is bounded at
# ~LOG_MAX_SIZE * (LOG_MAX_FILES + 1). Defaults: 5 MiB and 5 archives (~30 MiB).
LOG_MAX_SIZE=5242880              # bytes; 0 disables rotation
LOG_MAX_FILES=5                   # number of rotated archives to keep